+# Trong so cho diem xep hang tong hop (rank_score): uu tien do lien quan chu de (match_score)
+# la chinh, do gan GPA va gia tri hoc bong la phu — thay cho cach cu chi sap theo GPA-gap/amount
+# va bo qua hoan toan match_score (truoc day match_score chi dung de hien thi badge % tren UI).
+_RANK_WEIGHT_MATCH_SCORE = 0.6
+_RANK_WEIGHT_GPA_CLOSENESS = 0.25
+_RANK_WEIGHT_AMOUNT = 0.15
+
+
+def _gpa_closeness(gpa_gap: float | None) -> float:
+    """Doi do lech GPA (cang nho cang tot) thanh diem gan (0..1, cang cao cang tot).
+    Thieu du lieu GPA (gap=None) -> tra ve 0.5 (trung lap, khong thien vi tieu chi nay)."""
+    if gpa_gap is None:
+        return 0.5
+    return max(0.0, 1.0 - gpa_gap / 4.0)
+
+
+def _amount_normalized(amount: float | None, max_amount: float) -> float:
+    """Chuan hoa gia tri hoc bong ve doan 0..1 tuong doi trong danh sach dang xep hang."""
+    if not amount or max_amount <= 0:
+        return 0.0
+    return min(1.0, amount / max_amount)
+
